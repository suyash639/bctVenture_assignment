{
  "name": "meta-ads-creative-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Static dashboard for the AdVision AI creative analysis. Reads only public/data/*.json produced by `python -m src.export.dashboard_data`.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@14.2.4 out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "25.0.1",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
