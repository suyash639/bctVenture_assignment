# AdVision AI — environment variables (copy to .env; every variable is optional).

# Logging (DEBUG, INFO, WARNING, ERROR) — used by every CLI via src/utils/logging.py
LOG_LEVEL=INFO

# CLIP feature extraction (src/vision/clip_embeddings.py; defaults in config/settings.py VISION_CONFIG)
ADVISION_CLIP_MODEL=ViT-B-32
ADVISION_CLIP_PRETRAINED=laion2b_s34b_b79k
# cpu (bit-reproducible, default) | mps (Apple GPU) | cuda | auto
ADVISION_CLIP_DEVICE=cpu
ADVISION_CLIP_BATCH_SIZE=16
# Longest side (px) of the copy used for colour/brightness statistics
ADVISION_ANALYSIS_MAX_SIDE=512

# Hugging Face cache for CLIP weights (~600 MB, downloaded once). Unset = ~/.cache/huggingface
# HF_HOME=
